erDiagram
    %% Solid edges: enforced foreign keys. Dashed edges: logical legacy links.
    alembic_version {
        varchar version_num PK
    }
    channel_checks {
        bigint channel_id PK
        varchar state
        float next_check_at
        integer attempts
        varchar last_error
        varchar import_sha256
        text source_urls
        text attribution
    }
    channels {
        bigint channel_id PK
        varchar channelnick
        datetime added_at
        tinyint status
        integer likes
        integer dislikes
        float avg_score
        bigint subscriber_count
        varchar subscriber_display
        datetime last_post_at
        datetime last_checked_at
    }
    discovered_channels {
        bigint telegram_id PK
        bigint channel_id FK
        varchar username
        json sources
        float verified_at
        varchar identity_source
    }
    legacy_imports {
        varchar sha256 PK
        datetime completed_at
    }
    ratings {
        bigint telegram_id PK
        bigint channel_id PK
        integer score
    }
    subscribtions {
        bigint user_id PK
        integer sub_level
        datetime expires_at
    }
    users {
        bigint telegram_id PK
        varchar username
        datetime registred_at
        integer level
        integer level_points
        integer viewed_channels
        integer suggested_channels
        integer likes
        integer dislikes
        float ld_ratio
        integer last_channel_id
        datetime last_online
        tinyint awaiting_suggestion
    }
    verification_control {
        varchar name PK
        float not_before
    }
    webhook_inbox {
        bigint sequence PK
        bigint update_id
        bigint chat_id
        json payload
        varchar state
        integer attempts
        float next_attempt_at
        float lease_until
        json actions
        float completed_at
        text last_error
        float received_at
    }
    channels ||--o| channel_checks : "FK"
    channels ||--o{ discovered_channels : "FK"
    users ||..o{ ratings : "logical telegram_id to telegram_id"
    channels ||..o{ ratings : "logical channel_id to channel_id"
    users ||..o| subscribtions : "logical telegram_id to user_id"
    channels ||..o{ users : "logical channel_id to last_channel_id"
