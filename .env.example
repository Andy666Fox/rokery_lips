# Application settings (SSH credentials do not belong in this file).
TG_CHANNEL=Synchronisica
TG_CACHE_TTL=60
TG_CACHE_STALE_TTL=3600
TG_HTTP_TIMEOUT=5
TG_PROXY=

# Production: DNS for this domain and www must point to the server.
SITE_DOMAIN=dedvnutri.space

# Local HTTP. Set DEV_BIND=0.0.0.0 to view from a phone on your LAN.
DEV_BIND=127.0.0.1
DEV_PORT=8080
