# Copy to .env.integration and replace passwords/secrets before running the stack.
# Hexadecimal passwords avoid URL escaping in DATABASE_URL.
MYSQL_PASSWORD=replace-with-random-hex-password
MYSQL_ROOT_PASSWORD=replace-with-different-random-hex-password
WEBHOOK_SECRET=replace-with-random-secret-at-least-32-characters
# Set the BotFather token to enable Telegram replies.
BOT_TOKEN=
MONITORING_EMAIL=admin@example.com
MONITORING_PASSWORD=replace-with-a-unique-monitoring-password
# scripts.bootstrap_monitoring fills these after the Beszel account is available.
BESZEL_KEY=
BESZEL_TOKEN=
